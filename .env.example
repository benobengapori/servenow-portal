# NestJS API base URL, including the version prefix
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1

# Set to 1 to run the portal against the in-memory mock API (no backend needed)
NEXT_PUBLIC_API_MOCK=1

# Stripe publishable key; required for real 3-D Secure challenges (pk_test_… in development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
